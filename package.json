{
  "name": "neon-necropolis",
  "version": "1.0.0",
  "description": "Cyberpunk auto-shooter arcade game - MAO autonomous build test project",
  "type": "module",
  "main": "index.html",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "game",
    "arcade",
    "shooter",
    "cyberpunk",
    "zombies",
    "canvas",
    "typescript",
    "mao"
  ],
  "author": "MAO Autonomous Agents",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vitest/ui": "^1.0.0",
    "eslint": "^8.55.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2",
    "vite": "^5.0.5",
    "vitest": "^1.0.0"
  },
  "dependencies": {},
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webdevtodayjason/Neon-Necropolis.git"
  },
  "bugs": {
    "url": "https://github.com/webdevtodayjason/Neon-Necropolis/issues"
  },
  "homepage": "https://github.com/webdevtodayjason/Neon-Necropolis#readme"
}
